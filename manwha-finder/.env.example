ANTHROPIC_API_KEY=your_key_here
PORT=3001

# Optional — a hosted Turso (libSQL) database for production/Vercel.
# Leave both blank for local dev: a local SQLite file is used automatically.
# Create a free database with the Turso CLI:
#   turso db create manwha-finder
#   turso db show manwha-finder --url
#   turso db tokens create manwha-finder
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
